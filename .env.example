# Copy to `.env` (gitignored) and fill in only what you need. Blank values fall back to the default,
# so an empty entry behaves exactly like no override.
#
#   cp .env.example .env
#   uv run --env-file .env poe2-rag ask "How much mana does Spark cost?"
#
# Never commit `.env`: it holds the credential below.

# Required by `ask` only. The Anthropic SDK reads it; this package never stores, logs or prints it,
# and `ingest` works without it.
ANTHROPIC_API_KEY=

# Optional overrides. Relative paths resolve against POE2_RAG_PROJECT_ROOT, which defaults to the
# working directory.
POE2_RAG_PROJECT_ROOT=
POE2_RAG_RAW_DIR=
POE2_RAG_PROCESSED_DIR=
POE2_RAG_INDEX_DIR=
POE2_RAG_PATCH_CATALOG=
POE2_RAG_EMBEDDER_MODEL=
POE2_RAG_RERANKER_MODEL=
POE2_RAG_LLM_MODEL=
POE2_RAG_LLM_MAX_TOKENS=
POE2_RAG_LLM_EFFORT=

# Required by `ingest poe2db`. It travels in the User-Agent as the contact of whoever runs the fetch;
# there is no committed default, and fetching without it is a configuration error (ADR-0002).
# Example: POE2_RAG_HTTP_CONTACT=ops@example.com
POE2_RAG_HTTP_CONTACT=

# Optional poe2db pacing. The interval is the minimum seconds between requests to the same host; the
# timeout is how long one request may take.
POE2_RAG_HTTP_REQUEST_INTERVAL=
POE2_RAG_HTTP_TIMEOUT=
